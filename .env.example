# Login com Google (copie para .env e preencha; o .env não vai para o git).

# Client ID OAuth do Google Cloud, tipo "Aplicativo da Web".
# Em "Origens JavaScript autorizadas" cadastre http://localhost, http://localhost:5173
# e o endereço onde o app for publicado.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Administradores fixos: sempre entram e gerenciam os usuários (menu da conta › Usuários).
ADMIN_EMAILS=voce@gmail.com

# Qualquer conta Google entra; no primeiro acesso vira "free" (gratuito).
# Opcional: e-mails ou domínios ("@empresa.com") que já entram como "user".
ALLOWED_EMAILS=

# Segredo do cookie de sessão (32+ caracteres). Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Relatórios na nuvem: Postgres (Neon). Use a URL "Pooled connection" do painel do Neon.
# Sem ela o app funciona, mas "salvar na nuvem" fica desligado.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Opcional: duração da sessão em horas (padrão 12) e porta do npm start (padrão 8080).
# SESSION_HOURS=12
# PORT=8080
